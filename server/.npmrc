# The engines field is only a WARNING by default, buried in the deprecation
# notices npm prints. Installing on an old Node then proceeded all the way to
# compiling duckdb, which fails inside node-pre-gyp with a bare
# "SyntaxError: Unexpected token '.'" — optional chaining the old runtime
# cannot parse, and nothing naming the real cause. This makes the version check
# an error, raised while the tree is being resolved, before any dependency is
# built.
engine-strict=true
