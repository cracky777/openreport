exports[`multi-fact fan-out SQL is stable — mssql 1`] = `"SELECT COALESCE(g0.[produit], g1.[produit]) AS [produit], g0.[ventes], g1.[retours] FROM (SELECT [product].[name] AS [produit], SUM([sales].[amount]) AS [ventes] FROM [sales] LEFT JOIN [product] ON [product].[id] = [sales].[product_id] GROUP BY [product].[name]) g0 FULL JOIN (SELECT [product].[name] AS [produit], SUM([returns].[amount]) AS [retours] FROM [returns] LEFT JOIN [product] ON [product].[id] = [returns].[product_id] GROUP BY [product].[name]) g1 ON g0.[produit] = g1.[produit] ORDER BY [produit] OFFSET 0 ROWS FETCH NEXT 1000 ROWS ONLY"`;

