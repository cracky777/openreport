exports[`intersection-filtered measure SQL is stable — postgres 1`] = `"SELECT "items"."label" AS "label", SUM(CASE WHEN "items"."label" = 'active' THEN "items"."amt" END) AS "amt_active" FROM "items" GROUP BY "items"."label" ORDER BY "items"."label" LIMIT 1000"`;

